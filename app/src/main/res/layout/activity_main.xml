<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardBackgroundColor="#33FFFFFF"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/avatar" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.2"
                        android:text="REOMOD"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Fix lag nhẹ · giảm rung · tâm tĩnh"
                        android:textColor="#DDFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status"
            android:padding="12dp"
            android:text="○ Chưa kết nối Shizuku"
            android:textColor="#FBBF24"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="KẾT NỐI SHIZUKU"
            android:textColor="@color/accent"
            app:cornerRadius="14dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/breatheCard"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="80dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="2dp">

            <TextView
                android:id="@+id/breatheText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="12dp"
                android:text="Hít vào... 4"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.15"
            android:text="TÙY CHỌN"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swHaptic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:padding="12dp"
                    android:text="📳  Giảm rung &amp; âm chạm"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAnim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:padding="12dp"
                    android:text="✨  Tắt animation (cảm giác mượt)"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swBlur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:padding="12dp"
                    android:text="🌫️  Tắt blur nền (giảm tải GPU)"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swGpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="🎨  Force GPU rendering"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swBgLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="⚙️  Giới hạn background process"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swRam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:padding="12dp"
                    android:text="🧠  Dọn RAM nền"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:padding="12dp"
                    android:text="🗑️  Dọn cache hệ thống"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swDropCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="💧  Drop kernel caches (best-effort)"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:padding="12dp"
                    android:text="🎮  Game Mode Performance (FF)"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swCpu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="🔥  Ép CPU performance (best-effort)"
                    android:textColor="@color/on_surface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="⚡  BẮT ĐẦU LÀM MƯỢT"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestore"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="↺  KHÔI PHỤC MẶC ĐỊNH"
            android:textColor="@color/accent"
            app:cornerRadius="14dp"
            app:strokeColor="@color/accent"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.15"
            android:text="NHẬT KÝ"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#0A0F1C"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface"
            app:strokeWidth="1dp">

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Sẵn sàng."
                    android:textColor="#A5F3FC"
                    android:textSize="12sp" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
